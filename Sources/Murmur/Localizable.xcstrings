    "Press once to start, again to stop.": {
      "comment": "Subtitle of the dictation mode setting in toggle mode.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете веднъж за начало, отново за спиране."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte pro spuštění, znovu pro zastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang for at starte, igen for at stoppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal drücken zum Starten, erneut zum Stoppen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε μία φορά για έναρξη, ξανά για διακοπή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una vez para empezar y otra para parar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta alustamiseks korra, peatamiseks uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina kerran aloittaaksesi, uudelleen lopettaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois pour commencer, à nouveau pour arrêter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite jednom za početak, ponovno za zaustavljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg egyszer az indításhoz, újra a leállításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi una volta per iniziare, di nuovo per fermare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspauskite kartą, kad pradėtumėte, dar kartą – kad sustabdytumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nospiediet vienreiz, lai sāktu, un vēlreiz, lai apturētu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas darba biex tibda, erġa’ agħfas biex tieqaf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk één keer om te starten, nog eens om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij raz, aby zacząć, i ponownie, aby zatrzymać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima uma vez para começar e outra para parar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă o dată pentru a începe, din nou pentru a opri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите один раз, чтобы начать, и ещё раз, чтобы остановить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte raz na spustenie, znova na zastavenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite enkrat za začetek, znova za ustavitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck en gång för att börja, igen för att stoppa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть раз, щоб почати, ще раз — щоб зупинити."
          }
        }
      }
    },
    "Press once to start, again to stop. Best for longer dictation.": {
      "comment": "Setup mode card detail.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете веднъж за начало, отново за спиране. Най-добре за по-дълга диктовка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte pro spuštění, znovu pro zastavení. Ideální pro delší diktování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang for at starte, igen for at stoppe. Bedst til længere diktering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal drücken zum Starten, erneut zum Stoppen. Ideal für längere Diktate."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε μία φορά για έναρξη, ξανά για διακοπή. Ιδανικό για μεγαλύτερες υπαγορεύσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una vez para empezar y otra para parar. Ideal para dictados largos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta alustamiseks korra, peatamiseks uuesti. Sobib pikemaks dikteerimiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina kerran aloittaaksesi, uudelleen lopettaaksesi. Paras pidempiin saneluihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez une fois pour commencer, à nouveau pour arrêter. Idéal pour les dictées longues."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite jednom za početak, ponovno za zaustavljanje. Najbolje za dulje diktiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg egyszer az indításhoz, újra a leállításhoz. Hosszabb diktáláshoz ideális."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi una volta per iniziare, di nuovo per fermare. Ideale per dettature lunghe."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspauskite kartą, kad pradėtumėte, dar kartą – kad sustabdytumėte. Geriausia ilgesniam diktavimui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nospiediet vienreiz, lai sāktu, un vēlreiz, lai apturētu. Piemērots garākai diktēšanai."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas darba biex tibda, erġa’ agħfas biex tieqaf. L-aħjar għal dettatura itwal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk één keer om te starten, nog eens om te stoppen. Het best voor langer dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij raz, aby zacząć, i ponownie, aby zatrzymać. Najlepsze do dłuższego dyktowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima uma vez para começar e outra para parar. Ideal para ditados mais longos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă o dată pentru a începe, din nou pentru a opri. Ideal pentru dictări mai lungi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите один раз, чтобы начать, и ещё раз, чтобы остановить. Подходит для длинной диктовки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte raz na spustenie, znova na zastavenie. Ideálne na dlhšie diktovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite enkrat za začetek, znova za ustavitev. Najbolje za daljše narekovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck en gång för att börja, igen för att stoppa. Bäst för längre diktering."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть раз, щоб почати, ще раз — щоб зупинити. Найкраще для довгого диктування."
          }
        }
      }
    },
    "Press the key or combination you want. Esc cancels.": {
      "comment": "Tooltip on the shortcut recorder while it waits for a key.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете желания клавиш или комбинация. Esc отменя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte klávesu nebo kombinaci, kterou chcete. Esc zruší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på den tast eller kombination, du vil bruge. Esc annullerer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie die gewünschte Taste oder Kombination. Esc bricht ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το πλήκτρο ή τον συνδυασμό που θέλετε. Το Esc ακυρώνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla o combinación que quieras. Esc cancela."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vajuta soovitud klahvi või kombinatsiooni. Esc tühistab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina haluamaasi näppäintä tai yhdistelmää. Esc peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la touche ou la combinaison souhaitée. Esc annule."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite željenu tipku ili kombinaciju. Esc odustaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg a kívánt billentyűt vagy kombinációt. Az Esc megszakítja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il tasto o la combinazione che vuoi. Esc annulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paspauskite norimą klavišą arba kombinaciją. Esc atšaukia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nospiediet vajadzīgo taustiņu vai kombināciju. Esc atceļ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħfas il-buttuna jew il-kombinazzjoni li trid. Esc jikkanċella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op de toets of combinatie die je wilt. Esc annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij wybrany klawisz lub kombinację. Esc anuluje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima a tecla ou combinação que quiser. Esc cancela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă tasta sau combinația dorită. Esc anulează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите нужную клавишу или сочетание. Esc отменяет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte klávesu alebo kombináciu, ktorú chcete. Esc zruší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite želeno tipko ali kombinacijo. Esc prekliče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på den tangent eller kombination du vill använda. Esc avbryter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть потрібну клавішу чи комбінацію. Esc скасовує."
          }
        }
      }
    },
