    "After a one-time model download, no internet needed.": {
      "comment": "Welcome screen feature card detail.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След еднократно изтегляне на моделите не е нужен интернет."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po jednorázovém stažení modelu už internet nepotřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når modellerne er hentet én gang, kræves ingen internetforbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem einmaligen Modell-Download ist kein Internet nötig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από μία λήψη μοντέλου, δεν χρειάζεται διαδίκτυο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una descarga única de modelos, no hace falta internet."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pärast ühekordset mudeli allalaadimist pole internetti vaja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mallit on ladattu kerran, nettiä ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après un téléchargement unique des modèles, aucune connexion requise."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon jednokratnog preuzimanja modela internet nije potreban."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri modellletöltés után nincs szükség internetre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo un unico download dei modelli, non serve internet."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vienkartinio modelio atsisiuntimo interneto nebereikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pēc vienreizējas modeļa lejupielādes internets nav nepieciešams."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Wara tniżżila waħda tal-mudell, m’hemmx bżonn l-internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na één keer de modellen downloaden is er geen internet nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po jednorazowym pobraniu modelu internet nie jest potrzebny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após uma transferência única dos modelos, não precisa de Internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După o singură descărcare a modelelor, nu mai e nevoie de internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После однократного скачивания моделей интернет не нужен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po jednorazovom stiahnutí modelu už internet nepotrebujete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po enkratnem prenosu modelov internet ni potreben."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter en engångsnedladdning av modellerna behövs inget internet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після одноразового завантаження моделей інтернет не потрібен."
          }
        }
      }
    },
