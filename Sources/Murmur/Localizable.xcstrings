    "Murmur can’t use the microphone. Allow it in System Settings › Privacy & Security › Microphone.": {
      "comment": "Error shown when microphone permission was refused.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur не може да използва микрофона. Разрешете го в Системни настройки › Поверителност и сигурност › Микрофон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur nemůže použít mikrofon. Povolte ho v Nastavení systému › Soukromí a zabezpečení › Mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kan ikke bruge mikrofonen. Tillad det i Systemindstillinger › Anonymitet og sikkerhed › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kann das Mikrofon nicht verwenden. Erlauben Sie es in den Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Murmur δεν μπορεί να χρησιμοποιήσει το μικρόφωνο. Επιτρέψτε το στις Ρυθμίσεις συστήματος › Απόρρητο και ασφάλεια › Μικρόφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur no puede usar el micrófono. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ei saa mikrofoni kasutada. Luba see jaotises Süsteemi sätted › Privaatsus ja turvalisus › Mikrofon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ei voi käyttää mikrofonia. Salli se kohdassa Järjestelmäasetukset › Tietosuoja ja turvallisuus › Mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ne peut pas utiliser le microphone. Autorisez-le dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ne može upotrebljavati mikrofon. Dopustite to u Postavkama sustava › Privatnost i sigurnost › Mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Murmur nem tudja használni a mikrofont. Engedélyezze a Rendszerbeállítások › Adatvédelem és biztonság › Mikrofon alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur non può usare il microfono. Consentilo in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur negali naudoti mikrofono. Suteikite leidimą: Sistemos nuostatos › Privatumas ir saugumas › Mikrofonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur nevar izmantot mikrofonu. Atļaujiet to sadaļā Sistēmas iestatījumi › Konfidencialitāte un drošība › Mikrofons."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ma jistax juża l-mikrofon. Ħallih fi System Settings › Privacy u Sigurtà › Mikrofon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kan de microfoon niet gebruiken. Sta het toe in Systeeminstellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur nie może użyć mikrofonu. Zezwól na to w Ustawienia systemowe › Prywatność i bezpieczeństwo › Mikrofon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Murmur não consegue usar o microfone. Permita-o em Definições do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur nu poate folosi microfonul. Permite accesul în Setări sistem › Confidențialitate și securitate › Microfon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur не может использовать микрофон. Разрешите доступ в Системных настройках › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur nemôže použiť mikrofón. Povoľte ho v Nastaveniach systému › Súkromie a bezpečnosť › Mikrofón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ne more uporabljati mikrofona. Dovolite ga v Nastavitve sistema › Zasebnost in varnost › Mikrofon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kan inte använda mikrofonen. Tillåt det i Systeminställningar › Sekretess och säkerhet › Mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur не може використовувати мікрофон. Дозвольте це в Системних налаштуваннях › Конфіденційність і безпека › Мікрофон."
          }
        }
      }
    },
    "Murmur is busy with another dictation. Try again in a moment.": {
      "comment": "Error shown when a dictation is started while one is already running.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur е зает с друга диктовка. Опитайте отново след малко."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur právě diktuje. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur er optaget af en anden diktering. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ist mit einem anderen Diktat beschäftigt. Versuchen Sie es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Murmur ασχολείται με άλλη υπαγόρευση. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur está ocupado con otro dictado. Inténtalo de nuevo en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur on hõivatud teise dikteeringuga. Proovi hetke pärast uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur on jo sanelun keskellä. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur est occupé par une autre dictée. Réessayez dans un instant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur je zauzet drugim diktiranjem. Pokušajte ponovno za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Murmur éppen másik diktálást végez. Próbálja újra egy pillanat múlva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur è occupato con un’altra dettatura. Riprova tra un momento."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur užimtas kitu diktavimu. Bandykite dar kartą po akimirkos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur šobrīd diktē citu tekstu. Mēģiniet vēlreiz pēc brīža."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur qed jagħmel dettatura oħra. Erġa’ pprova fi ftit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur is bezig met een andere dicteersessie. Probeer het zo meteen opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur jest zajęty innym dyktowaniem. Spróbuj ponownie za chwilę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Murmur está ocupado com outro ditado. Tente novamente daqui a pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur este ocupat cu o altă dictare. Încearcă din nou într-o clipă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur занят другой диктовкой. Повторите попытку через мгновение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur práve spracúva iné diktovanie. Skúste to o chvíľu znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur je zaseden z drugim narekovanjem. Poskusite znova čez trenutek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur håller på med en annan diktering. Försök igen om en stund."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur зайнятий іншим диктуванням. Спробуйте за мить."
          }
        }
      }
    },
