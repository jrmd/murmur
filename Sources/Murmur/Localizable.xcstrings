    "Your dictation is sent as the user message. %@ is replaced with your dictionary’s spellings, and a line containing it is left out when the dictionary is empty.": {
      "comment": "Note under the system prompt editor. The placeholder is the vocabulary token.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовката ви се изпраща като потребителско съобщение. %@ се заменя с изписванията от речника ви, а редът, който го съдържа, се пропуска, когато речникът е празен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše diktování se odešle jako zpráva uživatele. %@ se nahradí podobou ze slovníku a řádek s ním se vynechá, když je slovník prázdný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din diktering sendes som brugermeddelelsen. %@ erstattes med din ordbogs stavemåder, og en linje, der indeholder den, udelades, når ordbogen er tom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Diktat wird als Benutzernachricht gesendet. %@ wird durch die Schreibweisen Ihres Wörterbuchs ersetzt, und eine Zeile, die es enthält, entfällt, wenn das Wörterbuch leer ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπαγόρευσή σας αποστέλλεται ως μήνυμα χρήστη. Το %@ αντικαθίσταται με τις ορθογραφίες του λεξικού σας και η γραμμή που το περιέχει παραλείπεται όταν το λεξικό είναι κενό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dictado se envía como mensaje del usuario. %@ se sustituye por las grafías de tu diccionario, y la línea que lo contiene se omite cuando el diccionario está vacío."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu dikteering saadetakse kasutaja sõnumina. %@ asendatakse sinu sõnastiku kirjaviisidega ja rida, mis seda sisaldab, jäetakse välja, kui sõnastik on tühi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelusi lähetetään käyttäjäviestinä. %@ korvataan sanastosi kirjoitusasuilla, ja sen sisältävä rivi jätetään pois, kun sanasto on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dictée est envoyée comme message utilisateur. %@ est remplacé par l’orthographe de votre dictionnaire, et la ligne qui le contient est omise quand le dictionnaire est vide."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše diktiranje šalje se kao poruka korisnika. %@ zamjenjuje se načinima pisanja iz vašeg rječnika, a redak koji ga sadrži izostavlja se kad je rječnik prazan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás felhasználói üzenetként kerül elküldésre. A %@ helyére a szótár írásmódjai kerülnek, és ha a szótár üres, az ezt tartalmazó sor kimarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua dettatura viene inviata come messaggio utente. %@ viene sostituito con le grafie del tuo dizionario e, quando il dizionario è vuoto, la riga che lo contiene viene omessa."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų diktavimas siunčiamas kaip naudotojo žinutė. %@ pakeičiamas jūsų žodyno rašyba, o eilutė, kurioje jis yra, praleidžiama, kai žodynas tuščias."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu diktējums tiek nosūtīts kā lietotāja ziņojums. %@ tiek aizstāts ar jūsu vārdnīcas rakstību, un rinda, kas to satur, tiek izlaista, ja vārdnīca ir tukša."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Id-dettatura tiegħek tintbagħat bħala l-messaġġ tal-utent. %@ jiġi sostitwit bl-ortografija tad-dizzjunarju tiegħek, u linja li fiha titħalla barra meta d-dizzjunarju jkun vojt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dicteertekst wordt als gebruikersbericht verstuurd. %@ wordt vervangen door de spellingen uit je woordenboek, en een regel die dat bevat wordt weggelaten als het woordenboek leeg is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dyktowanie jest wysyłane jako wiadomość użytkownika. %@ jest zastępowane pisownią ze słownika, a wiersz zawierający ten znacznik jest pomijany, gdy słownik jest pusty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu ditado é enviado como mensagem do utilizador. %@ é substituído pelas grafias do seu dicionário e a linha que o contém é omitida quando o dicionário está vazio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictarea ta este trimisă ca mesaj de utilizator. %@ este înlocuit cu ortografiile din dicționar, iar linia care îl conține este omisă când dicționarul este gol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша диктовка отправляется как сообщение пользователя. %@ заменяется написаниями из вашего словаря, а строка с ним опускается, если словарь пуст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše diktovanie sa odošle ako správa používateľa. %@ sa nahradí podobou zo slovníka a riadok s ním sa vynechá, keď je slovník prázdny."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše narekovanje se pošlje kot uporabniško sporočilo. %@ se nadomesti s črkovanjem iz vašega slovarja, vrstica, ki ga vsebuje, pa se izpusti, ko je slovar prazen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din diktering skickas som användarmeddelandet. %@ ersätts med stavningarna i din ordlista, och en rad som innehåller det utelämnas när ordlistan är tom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше диктування надсилається як повідомлення користувача. %@ замінюється написаннями з вашого словника, а рядок із ним не додається, коли словник порожній."
          }
        }
      }
    },
