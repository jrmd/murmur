    "Stop the download. It resumes from where it stopped next time.": {
      "comment": "Tooltip on the button that stops a model download.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрете изтеглянето. Следващия път то продължава от мястото, където е спряло."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví stahování. Příště bude pokračovat tam, kde skončilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop hentningen. Den fortsætter, hvor den stoppede, næste gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht das Laden ab. Beim nächsten Mal geht es dort weiter, wo es aufgehört hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακόπτει τη λήψη. Την επόμενη φορά συνεχίζει από εκεί που σταμάτησε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la descarga. Se reanuda donde se quedó la próxima vez."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Peata allalaadimine. Järgmisel korral jätkub sealt, kus pooleli jäi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytä lataus. Se jatkuu seuraavalla kerralla siitä, mihin jäi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le téléchargement. Il reprendra là où il s’est arrêté la prochaine fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaustavi preuzimanje. Sljedeći put nastavlja od mjesta na kojem je stalo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítja a letöltést. Legközelebb onnan folytatódik, ahol abbamaradt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il download. Riprenderà da dove si è fermato la prossima volta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustabdyti atsisiuntimą. Kitą kartą jis bus tęsiamas nuo tos vietos, kur sustojo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apturēt lejupielādi. Nākamreiz tā turpināsies no pārtraukšanas vietas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Waqqaf it-tniżżil. Jerġa’ jibda minn fejn waqaf il-ħin li jmiss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop de download. De volgende keer gaat het verder waar het gebleven was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj pobieranie. Następnym razem wznowi się od miejsca, w którym się zatrzymało."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar a transferência. Retoma de onde parou da próxima vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește descărcarea. Data viitoare reia de unde s-a oprit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить скачивание. В следующий раз оно продолжится с того же места."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví sťahovanie. Nabudúce bude pokračovať tam, kde skončilo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustavi prenos. Naslednjič se nadaljuje tam, kjer se je ustavil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa nedladdningen. Den fortsätter där den slutade nästa gång."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинити завантаження. Наступного разу воно продовжиться з місця зупинки."
          }
        }
      }
    },
