          "stringUnit": {
            "state": "translated",
            "value": "Добавете имена, марки и жаргон, които излизат грешно,\nи Murmur ще ги замества всеки път."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte jména, značky a odborné výrazy, které vycházejí špatně,\na Murmur je pokaždé nahradí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj navne, brands og jargon, der bliver gengivet forkert,\nog Murmur skifter dem ud hver gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Namen, Marken und Fachbegriffe hinzu, die falsch ankommen,\nund Murmur ersetzt sie jedes Mal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ονόματα, μάρκες και ορολογία που βγαίνουν λάθος,\nκαι ο Murmur θα τα αντικαθιστά κάθε φορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, marcas y jerga que salgan mal,\ny Murmur los cambiará siempre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa nimed, brändid ja terminid, mis valesti tulevad,\nja Murmur asendab need iga kord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää nimet, brändit ja erikoissanasto, jotka tulevat väärin,\nniin Murmur vaihtaa ne joka kerta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les noms, les marques et le jargon qui sortent mal,\net Murmur les remplacera à chaque fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte imena, brendove i žargon koji ispadnu pogrešno,\ni Murmur će ih svaki put zamijeniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá a rosszul kijövő neveket, márkákat és szakzsargont,\na Murmur pedig minden alkalommal kicseréli őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, marchi e termini tecnici che escono sbagliati,\ne Murmur li sostituirà ogni volta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite vardus, prekių ženklus ir žargoną, kuriuos Murmur išgirsta neteisingai,\nir jis juos visada pakeis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet vārdus, zīmolus un žargonu, ko Murmur pārraksta nepareizi,\nun Murmur tos aizstās katru reizi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żid ismijiet, brands u ġargon li joħorġu ħażin,\nu Murmur ibiddilhom kull darba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg namen, merken en jargon toe die er verkeerd uitkomen,\nen Murmur vervangt ze elke keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nazwiska, marki i żargon, które wychodzą błędnie,\na Murmur będzie je podmieniać za każdym razem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione nomes, marcas e jargão que saem errados,\ne o Murmur substitui-os sempre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă nume, mărci și jargon care ies greșit,\nși Murmur le va înlocui de fiecare dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена, бренды и термины, которые распознаются неверно,\nи Murmur будет подставлять их каждый раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte mená, značky a odborné výrazy, ktoré vychádzajú nesprávne,\na Murmur ich vždy nahradí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte imena, blagovne znamke in izraze, ki izpadejo napačno,\nin Murmur jih bo vsakič zamenjal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till namn, varumärken och facktermer som blir fel,\nså byter Murmur ut dem varje gång."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте імена, бренди й жаргон, які розпізнаються неправильно,\nі Murmur щоразу їх замінюватиме."
          }
        }
      }
    },
