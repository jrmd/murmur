    "A soft tick when Murmur starts and stops listening.": {
      "comment": "Subtitle of the play-sounds toggle.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Лек звук, когато Murmur започва и спира да слуша."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné cvaknutí, když Murmur začne a přestane poslouchat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blød kliklyd, når Murmur begynder og stopper med at lytte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leises Ticken, wenn Murmur das Zuhören startet und beendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας απαλός ήχος όταν ο Murmur αρχίζει και σταματά να ακούει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic suave cuando Murmur empieza y deja de escuchar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikne klõps, kui Murmur kuulamist alustab ja lõpetab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljainen naksahdus, kun Murmur aloittaa ja lopettaa kuuntelun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit clic discret quand Murmur commence et cesse d’écouter."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tihi klik kad Murmur počne i prestane slušati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Halk kattanás, amikor a Murmur hallgatni kezd, és amikor abbahagyja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un leggero tic quando Murmur inizia e smette di ascoltare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Švelnus tiksėjimas, kai Murmur pradeda ir nustoja klausytis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kluss klikšķis, kad Murmur sāk un pārstāj klausīties."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikka ħafifa meta Murmur jibda u jieqaf jisma’."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte tik wanneer Murmur begint en stopt met luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne kliknięcie, gdy Murmur zaczyna i kończy słuchać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique suave quando o Murmur começa e para de ouvir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic discret când Murmur începe și oprește ascultarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихий щелчок, когда Murmur начинает и прекращает слушать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné tiknutie, keď Murmur začne a prestane počúvať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tih klik, ko Murmur začne in preneha poslušati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svagt tick när Murmur börjar och slutar lyssna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихенький клац, коли Murmur починає й закінчує слухати."
          }
        }
      }
    },
