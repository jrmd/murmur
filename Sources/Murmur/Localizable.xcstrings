    "That’s it. Murmur asks once and remembers.": {
      "comment": "Setup step: the last instruction on the microphone step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е. Murmur пита веднъж и запомня."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vše. Murmur se zeptá jednou a zapamatuje si to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var det. Murmur spørger én gang og husker det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war’s. Murmur fragt einmal und merkt es sich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό ήταν. Ο Murmur ρωτά μία φορά και θυμάται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está. Murmur lo pide una vez y lo recuerda."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ongi kõik. Murmur küsib üks kord ja jätab meelde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siinä kaikki. Murmur kysyy kerran ja muistaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est tout. Murmur demande une fois et s’en souvient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je sve. Murmur pita jednom i pamti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennyi. A Murmur egyszer kérdez, és megjegyzi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto. Murmur chiede una volta sola e se lo ricorda."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai viskas. Murmur paklausia vieną kartą ir įsimena."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas arī viss. Murmur jautā vienreiz un atceras."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hekk hu. Murmur jistaqsi darba u jiftakar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is alles. Murmur vraagt het één keer en onthoudt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wszystko. Murmur pyta raz i zapamiętuje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É tudo. O Murmur pede uma vez e lembra-se."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gata. Murmur întreabă o singură dată și ține minte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот и всё. Murmur спросит один раз и запомнит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "To je všetko. Murmur sa opýta raz a zapamätá si to."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vse. Murmur vpraša enkrat in si zapomni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var allt. Murmur frågar en gång och kommer ihåg."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ось і все. Murmur запитає один раз і запам’ятає."
          }
        }
      }
    },
    "The microphone changed while Murmur was listening. Try again.": {
      "comment": "Error shown when the audio input route changed mid-recording.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофонът се смени, докато Murmur слушаше. Опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se během poslechu změnil. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen blev skiftet, mens Murmur lyttede. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon hat gewechselt, während Murmur zugehört hat. Versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μικρόφωνο άλλαξε όσο ο Murmur άκουγε. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono cambió mientras Murmur escuchaba. Inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon muutus Murmuri kuulamise ajal. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni vaihtui Murmurin kuunnellessa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone a changé pendant que Murmur écoutait. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se promijenio dok je Murmur slušao. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon megváltozott, miközben a Murmur hallgatott. Próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è cambiato mentre Murmur ascoltava. Riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas pasikeitė, kol Murmur klausėsi. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons nomainījās, kamēr Murmur klausījās. Mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-mikrofon inbidel waqt li Murmur kien qed jisma’. Erġa’ pprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon is gewijzigd terwijl Murmur luisterde. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon zmienił się, gdy Murmur słuchał. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone mudou enquanto o Murmur estava a ouvir. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfonul s-a schimbat în timp ce Murmur asculta. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон сменился, пока Murmur слушал. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón sa počas počúvania zmenil. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se je med poslušanjem Murmurja zamenjal. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen ändrades medan Murmur lyssnade. Försök igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон змінився, поки Murmur слухав. Спробуйте ще раз."
          }
        }
      }
    },
    "The model changed while Murmur was working. Try again.": {
