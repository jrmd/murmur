    "No microphone found. Pick an input in System Settings › Sound.": {
      "comment": "Error shown when no usable microphone exists.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не е намерен микрофон. Изберете вход в Системни настройки › Звук."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nenalezen. Vyberte vstup v Nastavení systému › Zvuk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofon fundet. Vælg en indgang i Systemindstillinger › Lyd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofon gefunden. Wählen Sie eine Eingabe in den Systemeinstellungen › Ton."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε μικρόφωνο. Επιλέξτε είσοδο στις Ρυθμίσεις συστήματος › Ήχος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún micrófono. Elige una entrada en Ajustes del Sistema › Sonido."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni ei leitud. Vali sisend jaotises Süsteemi sätted › Heli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonia ei löytynyt. Valitse tuloääni kohdassa Järjestelmäasetukset › Ääni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun microphone trouvé. Choisissez une entrée dans Réglages Système › Son."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađen mikrofon. Odaberite ulaz u Postavkama sustava › Zvuk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem található mikrofon. Válasszon bemenetet a Rendszerbeállítások › Hangok alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun microfono trovato. Scegli un ingresso in Impostazioni di Sistema › Suono."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonas nerastas. Pasirinkite įvestį: Sistemos nuostatos › Garsas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofons nav atrasts. Izvēlieties ievadi sadaļā Sistēmas iestatījumi › Skaņa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma nstab l-ebda mikrofon. Agħżel input fi System Settings › Ħoss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen microfoon gevonden. Kies een invoer in Systeeminstellingen › Geluid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono mikrofonu. Wybierz wejście w Ustawienia systemowe › Dźwięk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum microfone encontrado. Escolha uma entrada em Definições do Sistema › Som."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit niciun microfon. Alege o intrare în Setări sistem › Sunet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не найден. Выберите устройство ввода в Системных настройках › Звук."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenašiel sa žiadny mikrofón. Vyberte vstup v Nastaveniach systému › Zvuk."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ni najden. Izberite vhod v Nastavitve sistema › Zvok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofon hittades. Välj en ingång i Systeminställningar › Ljud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон не знайдено. Виберіть вхід у Системних налаштуваннях › Звук."
          }
        }
      }
    },
