    "Download the models in Settings › Models to start dictating.": {
      "comment": "Error shown when the user skipped the model download and then presses the dictation shortcut.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглете моделите в Настройки › Модели, за да започнете да диктувате."
          }
        },
        "cs": {
