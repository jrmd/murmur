    "Hold the key while you speak, let go to paste.": {
      "comment": "Subtitle of the dictation mode setting in hold mode.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте клавиша, докато говорите, и го отпуснете, за да поставите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte klávesu, když mluvíte, pusťte pro vložení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold tasten nede, mens du taler, og slip for at indsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Taste beim Sprechen gedrückt, lassen Sie zum Einfügen los."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το πλήκτρο όσο μιλάτε, αφήστε το για επικόλληση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la tecla mientras hablas y suelta para pegar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia klahvi all rääkimise ajal, kleepimiseks lase lahti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä näppäintä painettuna puhuessasi, päästä irti liittääksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche en parlant, relâchez pour coller."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite tipku dok govorite, pustite za lijepljenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa nyomva a billentyűt beszéd közben, engedje el a beillesztéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto mentre parli, rilascia per incollare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite klavišą nuspaudę, kol kalbate; atleiskite, kad įklijuotų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet taustiņu, kamēr runājat, un atlaidiet, lai ielīmētu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm il-buttuna waqt li titkellem, ħoll biex twaħħal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de toets vast terwijl je spreekt en laat los om te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz, mów, a potem puść, aby wkleić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tecla premida enquanto fala e largue para colar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține tasta apăsată cât vorbești, eliberează pentru a lipi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте клавишу, пока говорите, отпустите, чтобы вставить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte s podržanou klávesou, pustite a text sa vloží."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med govorjenjem držite tipko, za prilepitev jo spustite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll tangenten medan du talar och släpp för att klistra in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте клавішу, поки говорите, відпустіть, щоб вставити."
          }
        }
      }
    },
    "Hold the shortcut while you speak. Let go to paste. Best for quick notes.": {
      "comment": "Setup mode card detail.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте комбинацията, докато говорите. Отпуснете, за да поставите. Най-добре за бързи бележки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte zkratku, když mluvíte. Pusťte pro vložení. Ideální pro rychlé poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold genvejen nede, mens du taler. Slip for at indsætte. Bedst til hurtige noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie den Kurzbefehl beim Sprechen gedrückt. Lassen Sie zum Einfügen los. Ideal für kurze Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη συντόμευση όσο μιλάτε. Αφήστε την για επικόλληση. Ιδανικό για γρήγορες σημειώσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el atajo mientras hablas. Suelta para pegar. Ideal para notas rápidas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia kiirklahvi all rääkimise ajal. Kleepimiseks lase lahti. Sobib kiirmärkmeteks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä pikanäppäintä painettuna puhuessasi. Päästä irti liittääksesi. Paras pikamuistiinpanoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le raccourci en parlant. Relâchez pour coller. Idéal pour les notes rapides."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite prečac dok govorite. Pustite za lijepljenje. Najbolje za brze bilješke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszéd közben tartsa nyomva a gyorsbillentyűt. Engedje el a beillesztéshez. Gyors jegyzetekhez ideális."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la scorciatoia mentre parli. Rilascia per incollare. Ideale per note rapide."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite spartųjį klavišą nuspaudę, kol kalbate. Atleiskite, kad įklijuotų. Geriausia trumpoms pastaboms."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet īsceļu, kamēr runājat. Atlaidiet, lai ielīmētu. Piemērots īsām piezīmēm."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm is-shortcut waqt li titkellem. Ħoll biex twaħħal. L-aħjar għal noti malajr."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de sneltoets vast terwijl je spreekt. Laat los om te plakken. Het best voor korte notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj skrót, gdy mówisz. Puść, aby wkleić. Najlepsze do szybkich notatek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o atalho premido enquanto fala. Largue para colar. Ideal para notas rápidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține scurtătura apăsată cât vorbești. Eliberează pentru a lipi. Ideal pentru notițe rapide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте сочетание клавиш, пока говорите. Отпустите, чтобы вставить. Подходит для коротких заметок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte s podržanou skratkou. Pustením vložíte. Ideálne na rýchle poznámky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med govorjenjem držite bližnjico. Za prilepitev jo spustite. Najbolje za hitre zapiske."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll kortkommandot medan du talar. Släpp för att klistra in. Bäst för snabba anteckningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте сполучення клавіш, поки говорите. Відпустіть, щоб вставити. Найкраще для коротких нотаток."
          }
        }
      }
    },
