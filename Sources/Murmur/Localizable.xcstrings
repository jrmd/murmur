{
  "sourceLanguage": "en",
  "strings": {
    "%@ Your voice and text never leave this Mac.": {
      "comment": "Setup banner. The placeholder is a bold lead-in sentence.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Гласът и текстът ви никога не напускат този Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Váš hlas ani texty neopouštějí tento Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Din stemme og tekst forlader aldrig denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ihre Stimme und Ihr Text verlassen diesen Mac nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Η φωνή και το κείμενό σας δεν φεύγουν ποτέ από αυτό το Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tu voz y tus textos nunca salen de este Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sinu hääl ja tekst ei lahku kunagi sellest Macist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Äänesi ja tekstisi eivät koskaan poistu tältä Macilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Votre voix et vos textes ne quittent jamais ce Mac."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vaš glas i tekst nikad ne napuštaju ovaj Mac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hangja és szövege soha nem hagyja el ezt a Macet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La tua voce e i tuoi testi non lasciano mai questo Mac."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Jūsų balsas ir tekstas niekada nepalieka šio Mac."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Jūsu balss un teksts nekad neatstāj šo Mac."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Leħnek u t-test qatt ma joħorġu minn dan il-Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Je stem en tekst verlaten deze Mac nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Twój głos i teksty nie opuszczają tego Maca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A sua voz e os seus textos nunca saem deste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vocea și textul tău nu părăsesc niciodată acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ваш голос и текст никогда не покидают этот Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Váš hlas ani text nikdy neopustia tento Mac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vaš glas in besedilo nikoli ne zapustita tega Maca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Din röst och text lämnar aldrig den här Macen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ваш голос і текст ніколи не залишають цей Mac."
          }
        }
      }
    },
    "%@ has no GGUF files Murmur can run. Look for a repo with “GGUF” in its name.": {
      "comment": "Error in the custom clean-up sheet when the Hugging Face repo has no usable GGUF file. The placeholder is the repo name.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не съдържа GGUF файлове, които Murmur може да изпълни. Потърсете хранилище с „GGUF“ в името."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neobsahuje žádné soubory GGUF, které Murmur umí spustit. Hledejte repozitář s „GGUF“ v názvu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen GGUF-filer, som Murmur kan køre. Se efter et repo med „GGUF“ i navnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält keine GGUF-Dateien, die Murmur ausführen kann. Suchen Sie ein Repo mit „GGUF“ im Namen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ δεν έχει αρχεία GGUF που μπορεί να εκτελέσει ο Murmur. Αναζητήστε ένα αποθετήριο με «GGUF» στο όνομά του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene archivos GGUF que Murmur pueda ejecutar. Busca un repositorio con «GGUF» en el nombre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei sisalda GGUF-faile, mida Murmur käivitada saab. Otsi hoidlat, mille nimes on „GGUF”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei sisällä GGUF-tiedostoja, joita Murmur voi ajaa. Etsi repositorio, jonka nimessä on ”GGUF”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient aucun fichier GGUF que Murmur peut exécuter. Cherchez un dépôt avec « GGUF » dans son nom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nema nijednu GGUF datoteku koju Murmur može pokrenuti. Potražite repozitorij s „GGUF” u nazivu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nem tartalmaz Murmur által futtatható GGUF-fájlt. Keressen olyan tárolót, amelynek nevében szerepel a „GGUF”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non contiene file GGUF che Murmur possa eseguire. Cerca un repo con «GGUF» nel nome."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neturi GGUF failų, kuriuos Murmur galėtų paleisti. Ieškokite saugyklos, kurios pavadinime yra „GGUF“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nesatur GGUF failus, ko Murmur var palaist. Meklējiet repozitoriju, kuras nosaukumā ir „GGUF”."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ m’għandux fajls GGUF li Murmur jista’ jmexxi. Fittex repo bl-“GGUF” fl-isem tiegħu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft geen GGUF-bestanden die Murmur kan uitvoeren. Zoek een repo met „GGUF” in de naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie zawiera plików GGUF, których Murmur może użyć. Szukaj repozytorium z „GGUF” w nazwie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem ficheiros GGUF que o Murmur possa executar. Procure um repositório com «GGUF» no nome."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu are fișiere GGUF pe care Murmur le poate rula. Caută un repo cu „GGUF” în nume."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не содержит файлов GGUF, которые Murmur может запустить. Ищите репозиторий со словом «GGUF» в названии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neobsahuje žiadne súbory GGUF, ktoré by Murmur dokázal spustiť. Hľadajte repozitár s „GGUF“ v názve."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nima datotek GGUF, ki bi jih Murmur lahko zagnal. Poiščite repo z imenom, ki vsebuje „GGUF“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ innehåller inga GGUF-filer som Murmur kan köra. Leta efter ett repo med ”GGUF” i namnet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ немає файлів GGUF, які може запустити Murmur. Пошукайте репозиторій із «GGUF» у назві."
          }
        }
      }
    },
    "%@ macOS often needs Murmur to restart before the shortcut works. You’ll come straight back to this step.": {
      "comment": "Setup banner. The placeholder is a bold lead-in sentence.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS често се нуждае от рестартиране на Murmur, за да работи комбинацията. Ще се върнете направо към тази стъпка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS často potřebuje restart Murmuru, aby zkratka fungovala. Hned se vrátíte na tento krok."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS skal ofte genstarte Murmur, før genvejen virker. Du kommer direkte tilbage til dette trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS muss Murmur oft neu starten, bevor der Kurzbefehl funktioniert. Sie landen direkt wieder bei diesem Schritt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Το macOS συχνά χρειάζεται επανεκκίνηση του Murmur για να λειτουργήσει η συντόμευση. Θα επιστρέψετε αμέσως σε αυτό το βήμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS suele necesitar que Murmur se reinicie para que el atajo funcione. Volverás directamente a este paso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS vajab sageli Murmuri uuestikäivitust, enne kui kiirklahv töötab. Naased kohe selle sammu juurde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS vaatii usein Murmurin uudelleenkäynnistyksen ennen kuin pikanäppäin toimii. Palaat suoraan tähän vaiheeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS demande souvent à Murmur de redémarrer pour que le raccourci fonctionne. Vous reviendrez directement à cette étape."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS često treba ponovno pokrenuti Murmur prije nego prečac proradi. Odmah ćete se vratiti na ovaj korak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A gyorsbillentyű használatához a macOS-nek gyakran újra kell indítania a Murmurt. Utána egyenesen visszatér ehhez a lépéshez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS spesso richiede il riavvio di Murmur prima che la scorciatoia funzioni. Tornerai subito a questo passaggio."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kad spartusis klavišas veiktų, macOS dažnai reikia iš naujo paleisti Murmur. Iškart grįšite į šį žingsnį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS bieži ir nepieciešams, lai Murmur pārstartētos, pirms īsceļš sāk darboties. Jūs uzreiz atgriezīsities pie šī soļa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ħafna drabi macOS jeħtieġ li Murmur jerġa’ jibda qabel ma jaħdem is-shortcut. Terġa’ lura dritt għal dan il-pass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS moet Murmur vaak opnieuw starten voordat de sneltoets werkt. Je komt meteen terug bij deze stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS często wymaga ponownego uruchomienia Murmura, aby skrót działał. Wrócisz od razu do tego kroku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O macOS precisa muitas vezes que o Murmur reinicie para o atalho funcionar. Volta logo a este passo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS are nevoie adesea de o repornire a Murmur pentru ca scurtătura să funcționeze. Vei reveni direct la acest pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS часто требует перезапуска Murmur, чтобы сочетание клавиш заработало. Вы сразу вернётесь к этому шагу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS často potrebuje reštart Murmuru, aby skratka fungovala. Hneď sa vrátite na tento krok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS pogosto zahteva, da Murmur znova zaženete, preden bližnjica deluje. Takoj se boste vrnili na ta korak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS behöver ofta starta om Murmur innan kortkommandot fungerar. Du kommer direkt tillbaka till det här steget."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS часто потрібен перезапуск Murmur, перш ніж сполучення клавіш запрацює. Ви одразу повернетеся до цього кроку."
          }
        }
      }
    },
    "%@ so macOS applies the change.": {
      "comment": "Setup instruction. The placeholder is a bold “Relaunch Murmur”.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, за да приложи macOS промяната."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, aby macOS změnu použil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, så macOS anvender ændringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ damit macOS die Änderung übernimmt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ για να εφαρμόσει το macOS την αλλαγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para que macOS aplique el cambio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, et macOS muudatuse rakendaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, jotta macOS ottaa muutoksen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pour que macOS applique la modification."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kako bi macOS primijenio promjenu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, hogy a macOS alkalmazza a módosítást."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per applicare la modifica in macOS."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kad macOS pritaikytų pakeitimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, lai macOS piemērotu izmaiņas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ biex macOS japplika l-bidla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zodat macOS de wijziging doorvoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, aby macOS zastosował zmianę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para o macOS aplicar a alteração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pentru ca macOS să aplice modificarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, чтобы macOS применил изменение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, aby macOS zmenu uplatnil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, da macOS uveljavi spremembo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ så att macOS tillämpar ändringen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, щоб macOS застосувала зміну."
          }
        }
      }
    },
