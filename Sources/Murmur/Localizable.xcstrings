    "Pick how you start dictating. You can change this later in Settings.": {
      "comment": "Lead paragraph on the shortcut step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете как да започвате диктовка. Можете да промените това по-късно в Настройки."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, jak chcete diktovat. Později to můžete změnit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvordan du starter dikteringen. Du kan ændre det senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wie Sie das Diktieren starten. Sie können das später in den Einstellungen ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πώς ξεκινάτε την υπαγόρευση. Μπορείτε να το αλλάξετε αργότερα στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo empiezas a dictar. Puedes cambiarlo más tarde en Ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali, kuidas dikteerimist alustad. Seda saad hiljem sätetes muuta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, miten aloitat sanelun. Voit muuttaa tätä myöhemmin asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment lancer la dictée. Vous pourrez modifier ce choix plus tard dans les Réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite kako pokrećete diktiranje. To kasnije možete promijeniti u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, hogyan indítja a diktálást. Ezt később a Beállításokban módosíthatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come iniziare a dettare. Puoi cambiarlo più tardi in Impostazioni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite, kaip pradedate diktavimą. Vėliau tai galite pakeisti nuostatose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties, kā sākt diktēšanu. To vēlāk varat mainīt Iestatījumos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel kif tibda tiddetta. Tista’ tbiddel dan aktar tard fi Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe je begint met dicteren. Je kunt dit later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak zaczynasz dyktować. Możesz to później zmienić w Ustawieniach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como começa a ditar. Pode alterar isto mais tarde nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cum pornești dictarea. Poți schimba asta mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как начинать диктовку. Это можно изменить позже в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, ako budete diktovanie spúšťať. Neskôr to môžete zmeniť v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, kako začnete narekovati. To lahko pozneje spremenite v Nastavitvah."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur du startar dikteringen. Du kan ändra det senare i Inställningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як починати диктування. Це можна змінити пізніше в Налаштуваннях."
          }
        }
      }
    },
    "Pick your models and download them once. Dictation then works offline.": {
      "comment": "Lead paragraph on the models step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете моделите си и ги изтеглете веднъж. След това диктовката работи офлайн."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte modely a jednou je stáhněte. Diktování pak funguje offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dine modeller, og hent dem én gang. Derefter virker dikteringen offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ihre Modelle und laden Sie sie einmal. Danach funktioniert das Diktieren offline."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τα μοντέλα σας και κάντε λήψη μία φορά. Στη συνέχεια η υπαγόρευση λειτουργεί εκτός σύνδεσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus modelos y descárgalos una vez. Después, el dictado funciona sin conexión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali mudelid ja laadi need üks kord alla. Seejärel töötab dikteerimine võrguühenduseta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse mallisi ja lataa ne kerran. Sen jälkeen sanelu toimii ilman nettiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez vos modèles et téléchargez-les une fois. La dictée fonctionne ensuite hors ligne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite modele i preuzmite ih jednom. Diktiranje zatim radi bez interneta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a modelleket, és töltse le őket egyszer. A diktálás ezután internet nélkül is működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i modelli e scaricali una volta sola. Poi la dettatura funziona offline."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite modelius ir atsisiųskite juos vieną kartą. Tada diktavimas veiks neprisijungus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties modeļus un lejupielādējiet tos vienreiz. Pēc tam diktēšana darbojas bez interneta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel il-mudelli tiegħek u niżżilhom darba. Imbagħad id-dettatura taħdem offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je modellen en download ze één keer. Daarna werkt dicteren offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz modele i pobierz je raz. Potem dyktowanie działa offline."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os seus modelos e transfira-os uma vez. O ditado funciona depois offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege-ți modelele și descarcă-le o singură dată. Apoi dictarea funcționează offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модели и скачайте их один раз. После этого диктовка работает без интернета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si modely a raz ich stiahnite. Diktovanie potom funguje offline."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite modele in jih enkrat prenesite. Narekovanje nato deluje brez povezave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj dina modeller och ladda ner dem en gång. Sedan fungerar dikteringen offline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть моделі й завантажте їх один раз. Далі диктування працює офлайн."
          }
        }
      }
    },
