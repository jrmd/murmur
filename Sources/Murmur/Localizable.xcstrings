    "GitHub": {
      "comment": "A product name. Never translate.",
      "extractionState": "extracted_with_value",
      "shouldTranslate": false
    },
    "Give it a go. Hold %@, say something, then let go.": {
      "comment": "Setup instruction. The placeholder is the dictation shortcut.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитайте. Задръжте %@, кажете нещо и отпуснете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to. Podržte %@, něco řekněte a pusťte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv det. Hold %@, sig noget, og slip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probieren Sie es aus. Halten Sie %@ gedrückt, sagen Sie etwas und lassen Sie los."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε το. Κρατήστε το %@, πείτε κάτι και μετά αφήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo. Mantén %@, di algo y suelta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi järele. Hoia %@ all, ütle midagi ja lase lahti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile. Pidä %@ painettuna, sano jotain ja päästä irti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez. Maintenez %@, dites quelque chose, puis relâchez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprobajte. Držite %@, izgovorite nešto pa pustite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálja ki. Tartsa nyomva a %@ billentyűt, mondjon valamit, majd engedje el."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova. Tieni premuto %@, di’ qualcosa, poi rilascia."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pabandykite. Laikykite nuspaudę %@, pasakykite ką nors, tada atleiskite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamēģiniet. Turiet %@, pasakiet kaut ko un atlaidiet."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipprova. Żomm %@, għid xi ħaġa, imbagħad ħoll."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het. Houd %@ ingedrukt, zeg iets en laat los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj. Przytrzymaj %@, powiedz coś, a potem puść."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente. Mantenha %@ premido, diga algo e largue."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă. Ține apăsat %@, spune ceva, apoi eliberează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте. Удерживайте %@, скажите что-нибудь, затем отпустите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte to. Podržte %@, niečo povedzte a pustite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkusite. Držite %@, nekaj recite in spustite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa. Håll %@, säg något och släpp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте. Утримуйте %@, скажіть щось, потім відпустіть."
          }
        }
      }
    },
    "Give it a go. Press %@ to start, say something, then press it again.": {
      "comment": "Setup instruction. The placeholder is the dictation shortcut.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Опитайте. Натиснете %@, за да започнете, кажете нещо и натиснете отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste to. Stiskněte %@, něco řekněte a pak stiskněte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv det. Tryk på %@ for at starte, sig noget, og tryk igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probieren Sie es aus. Drücken Sie %@ zum Starten, sagen Sie etwas und drücken Sie erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε το. Πατήστε το %@ για να ξεκινήσετε, πείτε κάτι και μετά πατήστε το ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo. Pulsa %@ para empezar, di algo y vuelve a pulsarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi järele. Vajuta %@, et alustada, ütle midagi ja vajuta uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile. Paina %@ aloittaaksesi, sano jotain ja paina uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez. Appuyez sur %@ pour commencer, dites quelque chose, puis appuyez à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprobajte. Pritisnite %@ za početak, izgovorite nešto pa pritisnite ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbálja ki. Nyomja meg a %@ billentyűt, mondjon valamit, majd nyomja meg újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova. Premi %@ per iniziare, di’ qualcosa, poi premi di nuovo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pabandykite. Paspauskite %@, kad pradėtumėte, pasakykite ką nors, tada paspauskite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamēģiniet. Nospiediet %@, lai sāktu, pasakiet kaut ko un pēc tam nospiediet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipprova. Agħfas %@ biex tibda, għid xi ħaġa, imbagħad erġa’ agħfasha."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het. Druk op %@ om te beginnen, zeg iets en druk nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj. Naciśnij %@, aby zacząć, powiedz coś, a potem naciśnij ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente. Prima %@ para começar, diga algo e prima novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă. Apasă %@ pentru a începe, spune ceva, apoi apasă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте. Нажмите %@, чтобы начать, скажите что-нибудь, затем нажмите снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte to. Stlačte %@, niečo povedzte a potom stlačte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkusite. Pritisnite %@, da začnete, nekaj recite in pritisnite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa. Tryck på %@ för att börja, säg något och tryck igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте. Натисніть %@, щоб почати, скажіть щось, потім натисніть ще раз."
          }
        }
      }
    },
