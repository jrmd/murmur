    "Speech recognition and clean-up run entirely on this Mac.": {
      "comment": "Welcome screen feature card detail.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разпознаването на реч и изчистването се извършват изцяло на този Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání řeči i úprava probíhají zcela na tomto Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegenkendelse og oprydning kører udelukkende på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung und Bereinigung laufen komplett auf diesem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναγνώριση ομιλίας και ο καθαρισμός εκτελούνται εξ ολοκλήρου σε αυτό το Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz y la limpieza se ejecutan por completo en este Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnetuvastus ja korrastamine töötavad täielikult selles Macis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistus ja siistintä toimivat kokonaan tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale et le nettoyage s’exécutent entièrement sur ce Mac."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora i čišćenje rade u cijelosti na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédfelismerés és a tisztítás teljes egészében ezen a Macen fut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento vocale e pulizia funzionano interamente su questo Mac."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbos atpažinimas ir valymas vyksta visiškai šiame Mac kompiuteryje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runas atpazīšana un sakārtošana notiek pilnībā šajā Mac."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-rikonoxximent tad-diskors u t-tindif isiru kollha fuq dan il-Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning en opschonen gebeuren volledig op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy i korekta działają w całości na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de voz e a limpeza são feitos inteiramente neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recunoașterea vocală și curățarea rulează în întregime pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи и очистка выполняются полностью на этом Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávanie reči a úprava prebiehajú výhradne na tomto Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznavanje govora in čiščenje potekata v celoti na tem Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenkänning och städning körs helt på den här Macen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення й очищення повністю виконуються на цьому Mac."
          }
        }
      }
    },
