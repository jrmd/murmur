    "Input Monitoring lets Murmur notice your shortcut while another app is in front.": {
      "comment": "Lead paragraph on the input monitoring step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдението на входящите данни позволява на Murmur да забележи комбинацията ви, докато друга програма е на преден план."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování vstupu umožňuje Murmuru zachytit vaši zkratku, i když je vpředu jiná aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inputovervågning gør det muligt for Murmur at registrere din genvej, mens en anden app er i forgrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Eingabeüberwachung erkennt Murmur Ihren Kurzbefehl, auch wenn eine andere App im Vordergrund ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Παρακολούθηση εισόδου επιτρέπει στον Murmur να αντιλαμβάνεται τη συντόμευσή σας όταν μια άλλη εφαρμογή είναι στο προσκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorización de entrada permite a Murmur detectar tu atajo mientras otra app está en primer plano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisendi jälgimine võimaldab Murmuril märgata sinu kiirklahvi ka siis, kui ees on mõni teine rakendus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötteen valvonnan avulla Murmur huomaa pikanäppäimesi, vaikka toinen sovellus olisi edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La surveillance de la saisie permet à Murmur de détecter votre raccourci quand une autre app est au premier plan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Praćenje unosa omogućuje da Murmur primijeti vaš prečac dok je druga aplikacija u prvom planu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beviteli eszközök figyelése engedélyével a Murmur akkor is észleli a gyorsbillentyűt, ha más app van előtérben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoraggio input consente a Murmur di rilevare la scorciatoia mentre un’altra app è in primo piano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įvesties stebėjimas leidžia Murmur pastebėti jūsų spartųjį klavišą, kai priekyje yra kita programa."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievades uzraudzība ļauj Murmur pamanīt īsceļu, kad priekšplānā ir cita lietotne."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-Input Monitoring iħalli lil Murmur jintebaħ bis-shortcut tiegħek waqt li app oħra tkun quddiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met invoerbewaking merkt Murmur je sneltoets op terwijl een andere app op de voorgrond staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorowanie wprowadzania pozwala Murmurowi zauważyć Twój skrót, gdy na wierzchu jest inna aplikacja."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Monitorização de Entrada permite ao Murmur detetar o seu atalho quando outra app está em primeiro plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorizarea intrării îi permite lui Murmur să detecteze scurtătura când o altă aplicație este în prim-plan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мониторинг ввода позволяет Murmur замечать сочетание клавиш, когда активно другое приложение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovanie vstupu umožní Murmuru zachytiť skratku, aj keď je vpredu iná aplikácia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljanje vnosa Murmuru omogoča, da zazna vašo bližnjico, ko je v ospredju druga aplikacija."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Inmatningsövervakning kan Murmur upptäcka ditt kortkommando även när en annan app är i förgrunden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моніторинг введення дає Murmur змогу помічати ваше сполучення клавіш, коли активною є інша програма."
          }
        }
      }
    },
