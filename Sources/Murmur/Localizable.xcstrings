    "Click Record, then press the key or combination you want.": {
      "comment": "Hint under the shortcut recorder.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете върху „Запис“, след което натиснете желания клавиш или комбинация."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na Nahrát a pak stiskněte klávesu nebo kombinaci, kterou chcete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på Optag, og tryk derefter på den tast eller kombination, du vil bruge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf Aufnehmen und drücken Sie dann die gewünschte Taste oder Kombination."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στην Εγγραφή και μετά πατήστε το πλήκτρο ή τον συνδυασμό που θέλετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Grabar y pulsa la tecla o combinación que quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa nupul Salvesta, seejärel vajuta soovitud klahvi või klahvikombinatsiooni."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta Nauhoita ja paina haluamaasi näppäintä tai yhdistelmää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Enregistrer, puis appuyez sur la touche ou la combinaison souhaitée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite Snimi pa pritisnite željenu tipku ili kombinaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a Felvétel gombra, majd nyomja meg a kívánt billentyűt vagy kombinációt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Registra, poi premi il tasto o la combinazione che vuoi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustelėkite „Įrašyti“, tada paspauskite norimą klavišą arba kombinaciją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet uz Ierakstīt un pēc tam nospiediet vajadzīgo taustiņu vai kombināciju."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikklikkja fuq Irrekordja, imbagħad agħfas il-buttuna jew il-kombinazzjoni li trid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ‘Opnemen’ en druk dan op de toets of combinatie die je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij Nagraj, a następnie naciśnij wybrany klawisz lub kombinację."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Gravar e prima a tecla ou combinação que quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă clic pe Înregistrează, apoi apasă tasta sau combinația dorită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
