          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen blev skiftet, mens Murmur arbejdede. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat gewechselt, während Murmur gearbeitet hat. Versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο άλλαξε όσο ο Murmur εργαζόταν. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo cambió mientras Murmur trabajaba. Inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudel muutus Murmuri töötamise ajal. Proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Malli vaihtui Murmurin työskennellessä. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle a changé pendant que Murmur travaillait. Réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se promijenio dok je Murmur radio. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modell megváltozott, miközben a Murmur dolgozott. Próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è cambiato mentre Murmur lavorava. Riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelis pasikeitė, kol Murmur dirbo. Bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelis nomainījās, kamēr Murmur strādāja. Mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-mudell inbidel waqt li Murmur kien qed jaħdem. Erġa’ pprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model is gewijzigd terwijl Murmur bezig was. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model zmienił się, gdy Murmur pracował. Spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo mudou enquanto o Murmur estava a trabalhar. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul s-a schimbat în timp ce Murmur lucra. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель сменилась, пока Murmur работал. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sa počas spracovania zmenil. Skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model se je med delovanjem Murmurja zamenjal. Poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen ändrades medan Murmur arbetade. Försök igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель змінилася, поки Murmur працював. Спробуйте ще раз."
          }
        }
      }
    },
    "This is a large file. Smaller models respond faster, which matters for dictation.": {
      "comment": "Warning shown when the chosen GGUF file is very large.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е голям файл. По-малките модели отговарят по-бързо, което е важно за диктовката."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle je velký soubor. Menší modely odpovídají rychleji, což je pro diktování důležité."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en stor fil. Mindre modeller svarer hurtigere, og det betyder noget for dikteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine große Datei. Kleinere Modelle antworten schneller, was beim Diktieren zählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό είναι μεγάλο αρχείο. Τα μικρότερα μοντέλα ανταποκρίνονται πιο γρήγορα, κάτι που μετράει στην υπαγόρευση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un archivo grande. Los modelos más pequeños responden más rápido, algo que importa para el dictado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on suur fail. Väiksemad mudelid vastavad kiiremini, mis on dikteerimise juures oluline."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on suuri tiedosto. Pienemmät mallit vastaavat nopeammin, millä on merkitystä sanelussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est volumineux. Les modèles plus petits répondent plus vite, ce qui compte pour la dictée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je velika datoteka. Manji modeli odgovaraju brže, što je važno za diktiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy nagy fájl. A kisebb modellek gyorsabban válaszolnak, ami diktálásnál számít."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un file grande. I modelli più piccoli rispondono più in fretta, il che conta per la dettatura."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai didelis failas. Mažesni modeliai atsako greičiau, o tai svarbu diktavimui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ir liels fails. Mazāki modeļi atbild ātrāk, un diktēšanai tas ir svarīgi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan huwa fajl kbir. Mudelli iżgħar iwieġbu aktar malajr, u dan huwa importanti għad-dettatura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een groot bestand. Kleinere modellen reageren sneller, wat bij dicteren uitmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To duży plik. Mniejsze modele odpowiadają szybciej, co ma znaczenie przy dyktowaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ficheiro é grande. Modelos mais pequenos respondem mais depressa, o que é importante para o ditado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un fișier mare. Modelele mai mici răspund mai repede, ceea ce contează pentru dictare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это большой файл. Меньшие модели отвечают быстрее, а для диктовки это важно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je veľký súbor. Menšie modely odpovedajú rýchlejšie, čo je pri diktovaní dôležité."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je velika datoteka. Manjši modeli se odzivajo hitreje, kar je pri narekovanju pomembno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en stor fil. Mindre modeller svarar snabbare, vilket spelar roll för dikteringen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це великий файл. Менші моделі відповідають швидше, а це важливо для диктування."
          }
        }
      }
    },
