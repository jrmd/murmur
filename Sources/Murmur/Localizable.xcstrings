    "Accessibility lets Murmur paste your finished dictation into the app you’re using.": {
      "comment": "Lead paragraph on the accessibility step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпността позволява на Murmur да постави готовата ви диктовка в програмата, която използвате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpřístupnění umožňuje Murmuru vložit hotové diktování do aplikace, kterou používáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgængelighed gør det muligt for Murmur at indsætte din færdige diktering i den app, du bruger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Bedienungshilfen kann Murmur Ihr fertiges Diktat in die App einfügen, die Sie gerade nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Προσβασιμότητα επιτρέπει στον Murmur να επικολλά την ολοκληρωμένη υπαγόρευσή σας στην εφαρμογή που χρησιμοποιείτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilidad permite a Murmur pegar tu dictado terminado en la app que estés usando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Juurdepääsetavus võimaldab Murmuril kleepida valminud dikteeringu rakendusse, mida kasutad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöavun avulla Murmur voi liittää valmiin sanelun käyttämääsi sovellukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité permet à Murmur de coller votre dictée terminée dans l’app que vous utilisez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristupačnost omogućuje da Murmur zalijepi gotovo diktiranje u aplikaciju koju upotrebljavate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kisegítő lehetőségek lehetővé teszik, hogy a Murmur a kész diktálást abba az alkalmazásba illessze, amelyet éppen használ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilità consente a Murmur di incollare la dettatura finita nell’app che stai usando."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieinamumas leidžia Murmur įklijuoti baigtą diktavimą į programą, kurią naudojate."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieejamība ļauj Murmur ielīmēt gatavo diktējumu lietotnē, ko izmantojat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-Aċċessibilità tħalli lil Murmur iwaħħal id-dettatura lesta tiegħek fl-app li qed tuża."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met toegankelijkheid kan Murmur je dicteertekst plakken in de app die je gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępność pozwala Murmurowi wklejać gotowe dyktowanie do aplikacji, której używasz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Acessibilidade permite ao Murmur colar o ditado concluído na app que está a usar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesibilitatea îi permite lui Murmur să lipească dictarea finalizată în aplicația pe care o folosești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ позволяет Murmur вставлять готовую диктовку в приложение, в котором вы работаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjednodušenie ovládania umožní Murmuru vložiť hotové diktovanie do aplikácie, ktorú používate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostopnost Murmuru omogoča, da končano narekovanje prilepi v aplikacijo, ki jo uporabljate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Tillgänglighet kan Murmur klistra in din färdiga diktering i appen du använder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступність дає Murmur змогу вставляти готове диктування в програму, якою ви користуєтеся."
          }
        }
      }
    },
