    "Find %@ in the list and turn it on.": {
      "comment": "Setup instruction. The placeholder is the app name.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намерете %@ в списъка и го включете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najděte v seznamu %@ a zapněte ho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Find %@ på listen, og slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie %@ in der Liste und schalten Sie es ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε το %@ στη λίστα και ενεργοποιήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca %@ en la lista y actívalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia loendist %@ ja lülita see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsi luettelosta %@ ja kytke se päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez %@ dans la liste et activez-le."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronađite %@ na popisu i uključite ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keresse meg a listában a %@ elemet, és kapcsolja be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova %@ nell’elenco e attivalo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suraskite %@ sąraše ir įjunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodiet sarakstā %@ un ieslēdziet to."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sib %@ fil-lista u ixgħel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek %@ in de lijst en zet het aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź %@ na liście i włącz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre %@ na lista e ative-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește %@ în listă și activează-l."
          }
        },
        "ru": {
