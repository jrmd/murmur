    "Microphone access was denied. Turn Murmur on in System Settings › Privacy & Security › Microphone.": {
      "comment": "Microphone step: the permission was refused.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достъпът до микрофона е отказан. Включете Murmur в Системни настройки › Поверителност и сигурност › Микрофон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu byl zamítnut. Zapněte Murmur v Nastavení systému › Soukromí a zabezpečení › Mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen blev afvist. Slå Murmur til i Systemindstillinger › Anonymitet og sikkerhed › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff wurde abgelehnt. Schalten Sie Murmur in den Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στο μικρόφωνο δεν επιτράπηκε. Ενεργοποιήστε τον Murmur στις Ρυθμίσεις συστήματος › Απόρρητο και ασφάλεια › Μικρόφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso al micrófono. Activa Murmur en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonile juurdepääs keelati. Lülita Murmur sisse jaotises Süsteemi sätted › Privaatsus ja turvalisus › Mikrofon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttöoikeus evättiin. Kytke Murmur päälle kohdassa Järjestelmäasetukset › Tietosuoja ja turvallisuus › Mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au microphone a été refusé. Activez Murmur dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup mikrofonu je odbijen. Uključite Murmur u Postavkama sustava › Privatnost i sigurnost › Mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonhozzáférést elutasították. Kapcsolja be a Murmurt a Rendszerbeállítások › Adatvédelem és biztonság › Mikrofon alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al microfono negato. Attiva Murmur in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieiga prie mikrofono uždrausta. Įjunkite Murmur: Sistemos nuostatos › Privatumas ir saugumas › Mikrofonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuve mikrofonam tika liegta. Ieslēdziet Murmur sadaļā Sistēmas iestatījumi › Konfidencialitāte un drošība › Mikrofons."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-aċċess għall-mikrofon ġie miċħud. Ixgħel Murmur fi System Settings › Privacy u Sigurtà › Mikrofon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon is geweigerd. Zet Murmur aan in Systeeminstellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do mikrofonu. Włącz Murmur w Ustawienia systemowe › Prywatność i bezpieczeństwo › Mikrofon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone foi recusado. Ative o Murmur em Definições do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon a fost refuzat. Activează Murmur în Setări sistem › Confidențialitate și securitate › Microfon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону запрещён. Включите Murmur в Системных настройках › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu bol zamietnutý. Zapnite Murmur v Nastaveniach systému › Súkromie a bezpečnosť › Mikrofón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostop do mikrofona je bil zavrnjen. Vklopite Murmur v Nastavitve sistema › Zasebnost in varnost › Mikrofon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mikrofonen nekades. Slå på Murmur i Systeminställningar › Sekretess och säkerhet › Mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона відхилено. Увімкніть Murmur у Системних налаштуваннях › Конфіденційність і безпека › Мікрофон."
          }
        }
      }
    },
