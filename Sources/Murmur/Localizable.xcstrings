    "That doesn’t look like a Hugging Face link. Paste a model page URL or owner/name.": {
      "comment": "Error in the custom clean-up sheet when the pasted link is not a Hugging Face model page.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това не изглежда като връзка към Hugging Face. Поставете URL на страница на модел или owner/name."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nevypadá jako odkaz na Hugging Face. Vložte URL stránky modelu nebo owner/name."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke et Hugging Face-link. Indsæt en URL til en modelside eller ejer/navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einem Link zu Hugging Face aus. Fügen Sie eine Modellseiten-URL oder owner/name ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός δεν μοιάζει με σύνδεσμο Hugging Face. Επικολλήστε το URL μιας σελίδας μοντέλου ή κάτοχος/όνομα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece un enlace de Hugging Face. Pega la URL de una página de modelo o propietario/nombre."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ei näe välja nagu Hugging Face’i link. Kleebi mudelilehe URL või omanik/nimi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo ei näytä Hugging Face -linkiltä. Liitä mallisivun URL tai omistaja/nimi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un lien Hugging Face. Collez l’URL d’une page de modèle ou propriétaire/nom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To ne izgleda kao poveznica na Hugging Face. Zalijepite URL stranice modela ili owner/name."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem tűnik Hugging Face hivatkozásnak. Illesszen be egy modelloldal URL-t vagy tulajdonos/nevet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un link di Hugging Face. Incolla l’URL di una pagina di modello o owner/name."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai nepanašu į Hugging Face nuorodą. Įklijuokite modelio puslapio URL arba „savininkas/pavadinimas“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas neizskatās pēc Hugging Face saites. Ielīmējiet modeļa lapas URL vai īpašnieks/nosaukums."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
