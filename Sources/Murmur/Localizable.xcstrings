    "Murmur is still setting up its local models.": {
      "comment": "Message in the dictation overlay when the models are still loading.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur все още настройва локалните си модели."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ještě připravuje místní modely."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur er stadig ved at sætte sine lokale modeller op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur richtet seine lokalen Modelle noch ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Murmur ρυθμίζει ακόμη τα τοπικά του μοντέλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur aún está preparando sus modelos locales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur seadistab veel oma kohalikke mudeleid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur valmistelee vielä paikallisia mallejaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur termine la configuration de ses modèles locaux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur još postavlja svoje lokalne modele."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Murmur még a helyi modellek beállításával foglalkozik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur sta ancora preparando i modelli locali."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur vis dar ruošia vietinius modelius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur vēl sagatavo lokālos modeļus."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur għadu qed iħejji l-mudelli lokali tiegħu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur is nog bezig met het instellen van de lokale modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur wciąż przygotowuje modele lokalne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Murmur ainda está a preparar os modelos locais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur își pregătește încă modelele locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur всё ещё готовит локальные модели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ešte pripravuje svoje lokálne modely."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur še nastavlja lokalne modele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur förbereder fortfarande sina lokala modeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ще готує локальні моделі."
          }
        }
      }
