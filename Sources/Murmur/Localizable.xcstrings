    "Clean-up failed, so Murmur pasted the raw transcript.": {
      "comment": "Menu banner message when the clean-up model failed.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изчистването не успя, затова Murmur постави необработения текст."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava selhala, Murmur vložil neupravený přepis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydningen mislykkedes, så Murmur indsatte den rå transskription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung fehlgeschlagen, Murmur hat die rohe Transkription eingefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο καθαρισμός απέτυχε, οπότε ο Murmur επικόλλησε το ακατέργαστο κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza falló, así que Murmur pegó la transcripción sin procesar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrastamine ebaõnnestus, seega kleepis Murmur töötlemata transkriptsiooni."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siistintä epäonnistui, joten Murmur liitti raakatekstin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage a échoué, Murmur a donc collé la transcription brute."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čišćenje nije uspjelo pa je Murmur zalijepio izvorni transkript."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tisztítás nem sikerült, ezért a Murmur a nyers átiratot illesztette be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia non riuscita: Murmur ha incollato la trascrizione grezza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valymas nepavyko, todėl Murmur įklijavo neapdorotą tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakārtošana neizdevās, tāpēc Murmur ielīmēja neapstrādātu tekstu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tindif falla, għalhekk Murmur waħħal it-traskrizzjoni mhux maħduma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opschonen mislukt, dus Murmur heeft de ruwe transcriptie geplakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korekta nie powiodła się, więc Murmur wkleił surowy zapis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza falhou, por isso o Murmur colou a transcrição em bruto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Curățarea a eșuat, așa că Murmur a lipit transcrierea brută."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка не удалась, поэтому Murmur вставил исходный текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava zlyhala, preto Murmur vložil surový prepis."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čiščenje ni uspelo, zato je Murmur prilepil neobdelan prepis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Städningen misslyckades, så Murmur klistrade in råtexten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося очистити, тож Murmur вставив необроблений текст."
          }
        }
      }
    },
