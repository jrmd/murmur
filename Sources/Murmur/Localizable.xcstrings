    "Changes save automatically. Murmur listens for the shortcut even when it’s in the background.": {
      "comment": "Footer of the Shortcut section in Settings.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените се запазват автоматично. Murmur следи за комбинацията дори когато е във фонов режим."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se ukládají automaticky. Murmur naslouchá zkratce, i když je na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer gemmes automatisk. Murmur lytter efter genvejen, også når den er i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden automatisch gesichert. Murmur hört auf den Kurzbefehl, auch im Hintergrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές αποθηκεύονται αυτόματα. Ο Murmur ακούει τη συντόμευση ακόμη και όταν βρίσκεται στο παρασκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan automáticamente. Murmur detecta el atajo incluso en segundo plano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudatused salvestatakse automaatselt. Murmur kuulab kiirklahvi ka siis, kui on taustal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset tallentuvat automaattisesti. Murmur kuuntelee pikanäppäintä myös taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées automatiquement. Murmur écoute le raccourci même en arrière-plan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene se spremaju automatski. Murmur sluša prečac i kad je u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosítások automatikusan mentődnek. A Murmur a háttérben is figyeli a gyorsbillentyűt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono salvate automaticamente. Murmur rileva la scorciatoia anche quando è in background."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitimai išsaugomi automatiškai. Murmur reaguoja į spartųjį klavišą net veikdamas fone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmaiņas saglabājas automātiski. Murmur uztver īsceļu arī tad, kad darbojas fonā."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-bidliet jiġu salvati awtomatikament. Murmur jisma’ għas-shortcut anki meta jkun fil-background."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden automatisch bewaard. Murmur luistert naar de sneltoets, ook als het op de achtergrond is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zapisują się automatycznie. Murmur nasłuchuje skrótu nawet w tle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são guardadas automaticamente. O Murmur deteta o atalho mesmo quando está em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările se salvează automat. Murmur ascultă scurtătura chiar și când este în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения сохраняются автоматически. Murmur отслеживает сочетание клавиш, даже когда работает в фоне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny sa ukladajú automaticky. Murmur reaguje na skratku aj na pozadí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremembe se shranijo samodejno. Murmur posluša bližnjico tudi, ko je v ozadju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar sparas automatiskt. Murmur lyssnar efter kortkommandot även när det är i bakgrunden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни зберігаються автоматично. Murmur реагує на сполучення клавіш, навіть коли працює у фоні."
          }
        }
      }
    },
