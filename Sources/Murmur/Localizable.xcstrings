    "Speak naturally. Murmur transcribes and tidies up your words, then types them into whatever app you’re using.": {
      "comment": "Lead paragraph on the welcome screen.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорете естествено. Murmur транскрибира и подрежда думите ви, след което ги въвежда в програмата, която използвате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte přirozeně. Murmur váš projev přepíše a upraví a pak ho napíše do aplikace, kterou používáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal naturligt. Murmur transskriberer og rydder op i dine ord og skriver dem derefter ind i den app, du bruger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen Sie einfach normal. Murmur transkribiert und bereinigt Ihre Wörter und tippt sie dann in die App, die Sie gerade nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μιλήστε φυσικά. Ο Murmur μεταγράφει και τακτοποιεί τα λόγια σας και μετά τα πληκτρολογεί στην εφαρμογή που χρησιμοποιείτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con naturalidad. Murmur transcribe y ordena tus palabras, y luego las escribe en la app que estés usando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Räägi loomulikult. Murmur transkribeerib ja korrastab sinu sõnad ning trükib need seejärel rakendusse, mida kasutad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu luonnollisesti. Murmur litteroi ja siistii sanasi ja kirjoittaa ne käyttämääsi sovellukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez naturellement. Murmur transcrit et met en forme vos paroles, puis les tape dans l’app que vous utilisez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Govorite prirodno. Murmur transkribira i sređuje vaše riječi pa ih upisuje u aplikaciju koju upotrebljavate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszéljen természetesen. A Murmur leírja és rendbe teszi a szavait, majd beírja őket abba az appba, amelyet éppen használ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla naturalmente. Murmur trascrive e rifinisce le tue parole, poi le scrive nell’app che stai usando."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalbėkite natūraliai. Murmur atpažįsta ir išvalo jūsų žodžius, tada įveda juos į bet kurią naudojamą programą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Runājiet dabiski. Murmur pārraksta un sakārto jūsu vārdus, pēc tam ieraksta tos jebkurā lietotnē, ko izmantojat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tkellem b’mod naturali. Murmur jittraskrivi u jnaddaf kelmtek, imbagħad jiktibhom fl-app li tkun qed tuża."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek gewoon. Murmur schrijft je woorden uit, schoont ze op en typt ze in de app die je gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów naturalnie. Murmur zapisuje i porządkuje Twoje słowa, a potem wpisuje je w dowolnej aplikacji, której używasz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale naturalmente. O Murmur transcreve e arruma as suas palavras e escreve-as na app que estiver a usar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbește natural. Murmur transcrie și îți aranjează cuvintele, apoi le tastează în aplicația pe care o folosești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите естественно. Murmur распознаёт и очищает ваши слова, а затем вводит их в приложение, в котором вы работаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte prirodzene. Murmur prepíše a upraví vaše slová a potom ich napíše do aplikácie, ktorú používate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Govorite sproščeno. Murmur prepiše in počisti vaše besede ter jih vtipka v aplikacijo, ki jo uporabljate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tala naturligt. Murmur transkriberar och städar upp dina ord och skriver sedan in dem i appen du använder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
