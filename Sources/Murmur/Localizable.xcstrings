    "Pastes your last dictation again, without recording.": {
      "comment": "Subtitle of the paste-last-dictation shortcut setting.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставя отново последната ви диктовка, без запис."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu vloží vaše poslední diktování, bez nahrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsætter din seneste diktering igen, uden at optage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Ihr letztes Diktat erneut ein, ohne Aufnahme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλά ξανά την τελευταία υπαγόρευσή σας, χωρίς εγγραφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a pegar tu último dictado, sin grabar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleebib sinu viimase dikteeringu uuesti, ilma salvestamiseta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liittää viimeisimmän sanelun uudelleen nauhoittamatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle à nouveau votre dernière dictée, sans enregistrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno lijepi vaše zadnje diktiranje, bez snimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra beilleszti az utolsó diktálást, felvétel nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla di nuovo la tua ultima dettatura, senza registrare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar kartą įklijuoja paskutinį diktavimą neįrašydamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēlreiz ielīmē pēdējo diktējumu bez ierakstīšanas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iwaħħal l-aħħar dettatura tiegħek mill-ġdid, mingħajr ma jirrekordja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plakt je laatste dicteertekst opnieuw, zonder op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wkleja ponownie ostatnie dyktowanie, bez nagrywania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cola novamente o seu último ditado, sem gravar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește din nou ultima dictare, fără înregistrare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляет последнюю диктовку ещё раз, без записи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova vloží vaše posledné diktovanie bez nahrávania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova prilepi vaše zadnje narekovanje, brez snemanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistrar in din senaste diktering igen, utan att spela in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляє ваше останнє диктування ще раз, без запису."
          }
        }
      }
    },
