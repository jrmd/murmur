    "Hold your shortcut, speak, let go. The text lands where you’re typing.": {
      "comment": "Welcome screen feature card detail.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръжте комбинацията, говорете, отпуснете. Текстът се появява там, където пишете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte zkratku, mluvte, pusťte. Text se vloží tam, kde píšete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold genvejen nede, tal, og slip. Teksten lander der, hvor du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihren Kurzbefehl, sprechen Sie, lassen Sie los. Der Text landet dort, wo Sie gerade tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη συντόμευσή σας, μιλήστε, αφήστε την. Το κείμενο εμφανίζεται εκεί που πληκτρολογείτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu atajo, habla y suelta. El texto aparece donde estés escribiendo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia kiirklahvi all, räägi, lase lahti. Tekst ilmub sinna, kuhu parasjagu kirjutad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä pikanäppäintä, puhu, päästä irti. Teksti ilmestyy siihen, mihin kirjoitat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre raccourci, parlez, relâchez. Le texte s’insère là où vous tapez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite prečac, govorite, pustite. Tekst se upisuje tamo gdje tipkate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa nyomva a gyorsbillentyűt, beszéljen, engedje el. A szöveg oda kerül, ahol éppen gépel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la scorciatoia, parla, rilascia. Il testo arriva dove stai scrivendo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikykite spartųjį klavišą, kalbėkite, atleiskite. Tekstas atsiras ten, kur rašote."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet īsceļu, runājiet, atlaidiet. Teksts parādās tur, kur rakstāt."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm is-shortcut tiegħek, tkellem, ħoll. It-test jidħol fejn qed tikteb."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je sneltoets vast, spreek en laat los. De tekst komt waar je typt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj skrót, mów, puść. Tekst trafi tam, gdzie piszesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o atalho premido, fale e largue. O texto aparece onde está a escrever."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține scurtătura apăsată, vorbește, eliberează. Textul apare acolo unde scrii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте сочетание клавиш, говорите, отпустите. Текст появится там, где вы печатаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte skratku, hovorte, pustite. Text sa objaví tam, kde práve píšete."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite bližnjico, govorite, spustite. Besedilo se vstavi tja, kjer tipkate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll kortkommandot, tala och släpp. Texten hamnar där du skriver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте сполучення клавіш, говоріть, відпустіть. Текст з’явиться там, де ви пишете."
          }
        }
      }
    },
