    "Setup takes about two minutes: three permissions, a shortcut and two local models.": {
      "comment": "Footnote on the welcome screen.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройката отнема около две минути: три разрешения, една клавишна комбинация и два локални модела."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení zabere asi dvě minuty: tři oprávnění, zkratku a dva místní modely."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsætningen tager ca. to minutter: tre tilladelser, en genvej og to lokale modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung dauert etwa zwei Minuten: drei Berechtigungen, ein Kurzbefehl und zwei lokale Modelle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ρύθμιση διαρκεί περίπου δύο λεπτά: τρεις άδειες, μια συντόμευση και δύο τοπικά μοντέλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración tarda unos dos minutos: tres permisos, un atajo y dos modelos locales."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadistamine võtab umbes kaks minutit: kolm luba, üks kiirklahv ja kaks kohalikku mudelit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöönotto kestää noin kaksi minuuttia: kolme käyttöoikeutta, pikanäppäin ja kaksi paikallista mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration prend environ deux minutes : trois autorisations, un raccourci et deux modèles locaux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavljanje traje oko dvije minute: tri dopuštenja, jedan prečac i dva lokalna modela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítás körülbelül két percet vesz igénybe: három engedély, egy gyorsbillentyű és két helyi modell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione richiede circa due minuti: tre permessi, una scorciatoia e due modelli locali."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sąranka užtrunka apie dvi minutes: trys leidimai, spartusis klavišas ir du vietiniai modeliai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iestatīšana aizņem apmēram divas minūtes: trīs atļaujas, īsceļš un divi lokālie modeļi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-setup jieħu madwar żewġ minuti: tliet permessi, shortcut u żewġ mudelli lokali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellen duurt ongeveer twee minuten: drie machtigingen, een sneltoets en twee lokale modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja zajmuje około dwóch minut: trzy uprawnienia, skrót i dwa modele lokalne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração demora cerca de dois minutos: três permissões, um atalho e dois modelos locais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurarea durează aproximativ două minute: trei permisiuni, o scurtătură și două modele locale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка занимает около двух минут: три разрешения, сочетание клавиш и две локальные модели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenie trvá asi dve minúty: tri oprávnenia, skratka a dva lokálne modely."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namestitev traja približno dve minuti: tri dovoljenja, bližnjica in dva lokalna modela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationen tar ungefär två minuter: tre behörigheter, ett kortkommando och två lokala modeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування триває близько двох хвилин: три дозволи, сполучення клавіш і дві локальні моделі."
          }
        }
      }
    },
