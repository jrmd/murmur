    "You appear to be offline. Connect to the internet and retry.": {
      "comment": "Model download failed because there is no connection.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изглежда сте офлайн. Свържете се с интернет и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to, že jste offline. Připojte se k internetu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser ud til at være offline. Opret forbindelse til internettet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie scheinen offline zu sein. Stellen Sie eine Internetverbindung her und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται ότι είστε εκτός σύνδεσης. Συνδεθείτε στο διαδίκτυο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no tienes conexión. Conéctate a internet y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tundub, et oled võrguühenduseta. Ühendu internetiga ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytät olevan offline-tilassa. Yhdistä internetiin ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous semblez hors ligne. Connectez-vous à Internet et réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda da ste izvan mreže. Povežite se s internetom i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, nincs internetkapcsolata. Csatlakozzon a hálózathoz, és próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembri offline. Connettiti a internet e riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodo, kad esate neprisijungę. Prisijunkite prie interneto ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šķiet, ka esat bezsaistē. Izveidojiet savienojumu ar internetu un mēģiniet vēlreiz."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jidher li int offline. Qabbad mal-internet u erġa’ pprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lijkt offline te zijn. Maak verbinding met internet en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że nie masz połączenia. Połącz się z internetem i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece estar offline. Ligue-se à Internet e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că ești offline. Conectează-te la internet și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, вы не в сети. Подключитесь к интернету и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá sa, že ste offline. Pripojte sa na internet a skúste to znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videti je, da niste povezani. Povežite se z internetom in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verkar vara offline. Anslut till internet och försök igen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, ви офлайн. Підключіться до інтернету й повторіть."
          }
        }
      }
    },
    "You can change this any time in System Settings › Privacy & Security › Microphone.": {
      "comment": "Microphone step: where to change the permission later.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да промените това по всяко време в Системни настройки › Поверителност и сигурност › Микрофон."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle můžete kdykoli změnit v Nastavení systému › Soukromí a zabezpečení › Mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ændre det når som helst i Systemindstillinger › Anonymitet og sikkerhed › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können das jederzeit in den Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το αλλάξετε οποιαδήποτε στιγμή στις Ρυθμίσεις συστήματος › Απόρρητο και ασφάλεια › Μικρόφωνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esto en cualquier momento en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda saad igal ajal muuta jaotises Süsteemi sätted › Privaatsus ja turvalisus › Mikrofon."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa tätä milloin tahansa kohdassa Järjestelmäasetukset › Tietosuoja ja turvallisuus › Mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier ce choix à tout moment dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To možete promijeniti bilo kada u Postavkama sustava › Privatnost i sigurnost › Mikrofon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt bármikor módosíthatja a Rendszerbeállítások › Adatvédelem és biztonság › Mikrofon alatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiarlo quando vuoi in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai bet kada galite pakeisti: Sistemos nuostatos › Privatumas ir saugumas › Mikrofonas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "To jebkurā laikā varat mainīt sadaļā Sistēmas iestatījumi › Konfidencialitāte un drošība › Mikrofons."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ tbiddel dan fi kwalunkwe ħin fi System Settings › Privacy u Sigurtà › Mikrofon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit altijd wijzigen in Systeeminstellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to zmienić w każdej chwili w Ustawienia systemowe › Prywatność i bezpieczeństwo › Mikrofon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode alterar isto a qualquer momento em Definições do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți schimba asta oricând în Setări sistem › Confidențialitate și securitate › Microfon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно изменить в любой момент в Системных настройках › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto môžete kedykoľvek zmeniť v Nastaveniach systému › Súkromie a bezpečnosť › Mikrofón."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lahko kadar koli spremenite v Nastavitve sistema › Zasebnost in varnost › Mikrofon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ändra det när som helst i Systeminställningar › Sekretess och säkerhet › Mikrofon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна змінити будь-коли в Системних налаштуваннях › Конфіденційність і безпека › Мікрофон."
          }
        }
      }
    },
    "You can download it again at any time. Dictation won’t work until the models are back.": {
      "comment": "Message of the confirmation before deleting a model.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да го изтеглите отново по всяко време. Диктовката няма да работи, докато моделите не се върнат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete ho kdykoli stáhnout znovu. Diktování nebude fungovat, dokud modely nebudou zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan hente den igen når som helst. Dikteringen virker ikke, før modellerne er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können es jederzeit erneut laden. Diktieren funktioniert erst wieder, wenn die Modelle da sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να κάνετε ξανά λήψη οποιαδήποτε στιγμή. Η υπαγόρευση δεν θα λειτουργεί μέχρι να επανέλθουν τα μοντέλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes volver a descargarlo cuando quieras. El dictado no funcionará hasta que vuelvan los modelos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle saad igal ajal uuesti alla laadida. Dikteerimine ei tööta, kuni mudelid on tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit ladata sen uudelleen milloin tahansa. Sanelu ei toimi, ennen kuin mallit ovat takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le télécharger à nouveau à tout moment. La dictée ne fonctionnera pas tant que les modèles ne seront pas revenus."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete ga ponovno preuzeti bilo kada. Diktiranje neće raditi dok se modeli ne vrate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor újra letöltheti. A diktálás nem működik, amíg a modellek vissza nem kerülnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scaricarlo di nuovo quando vuoi. La dettatura non funziona finché i modelli non tornano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bet kada galite jį atsisiųsti iš naujo. Diktavimas neveiks, kol modeliai nebus grąžinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "To jebkurā laikā varat lejupielādēt vēlreiz. Diktēšana nedarbosies, kamēr modeļi nebūs atpakaļ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tista’ terġa’ tniżżlu fi kwalunkwe ħin. Id-dettatura ma taħdimx sakemm il-mudelli jerġgħu lura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het altijd opnieuw downloaden. Dicteren werkt niet tot de modellen terug zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz pobrać go ponownie w każdej chwili. Dyktowanie nie będzie działać, dopóki modele nie wrócą."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode transferi-lo novamente a qualquer momento. O ditado não funciona até os modelos estarem de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îl poți descărca din nou oricând. Dictarea nu va funcționa până când modelele nu revin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете скачать её снова в любой момент. Диктовка не будет работать, пока модели не вернутся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedykoľvek ho môžete znova stiahnuť. Kým modely nebudú späť, diktovanie nebude fungovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadar koli ga lahko znova prenesete. Narekovanje ne bo delovalo, dokler modelov ne bo nazaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ladda ner den igen när som helst. Dikteringen fungerar inte förrän modellerna är tillbaka."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете завантажити його знову будь-коли. Диктування не працюватиме, поки моделей немає."
          }
        }
      }
    },
