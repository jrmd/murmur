          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Respectarea majusculelor păstrează exact majusculele tale. Folosește ••• pentru a importa o listă (CSV sau JSON) sau a o exporta ca CSV."
          }
        },
        "ru": {
          "stringUnit": {
