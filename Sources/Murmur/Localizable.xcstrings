    "Murmur listens only while you hold your dictation shortcut.": {
      "comment": "Subtitle in the illustration of the macOS microphone permission prompt.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur слуша само докато задържате клавишната комбинация за диктовка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur poslouchá jen tehdy, když držíte zkratku pro diktování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur lytter kun, mens du holder din dikteringsgenvej nede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur hört nur zu, solange Sie Ihren Diktat-Kurzbefehl halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Murmur ακούει μόνο όσο κρατάτε τη συντόμευση υπαγόρευσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur solo escucha mientras mantienes tu atajo de dictado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kuulab ainult siis, kui hoiad all oma dikteerimise kiirklahvi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur kuuntelee vain, kun pidät sanelun pikanäppäintä painettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur n’écoute que lorsque vous maintenez votre raccourci de dictée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur sluša samo dok držite prečac za diktiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Murmur csak akkor hallgat, amikor nyomva tartja a diktálás gyorsbillentyűjét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ascolta solo mentre tieni premuta la scorciatoia di dettatura."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur klausosi tik tada, kai laikote nuspaudę diktavimo spartųjį klavišą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur klausās tikai tad, kamēr turat diktēšanas īsceļu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur jisma’ biss waqt li żżomm is-shortcut tad-dettatura tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur luistert alleen terwijl je de dicteersneltoets ingedrukt houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur słucha tylko wtedy, gdy przytrzymujesz skrót do dyktowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Murmur só ouve enquanto mantém o atalho de ditado premido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ascultă doar cât timp ții apăsată scurtătura de dictare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur слушает, только пока вы удерживаете сочетание клавиш для диктовки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur počúva len vtedy, keď držíte skratku na diktovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur posluša le, ko držite bližnjico za narekovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur lyssnar bara medan du håller dikteringskortkommandot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur слухає, лише поки ви утримуєте сполучення клавіш для диктування."
          }
        }
      }
    },
    "Murmur lives in your menu bar": {
