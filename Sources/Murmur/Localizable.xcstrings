    "Merging keeps the words you already have and updates any that match. Replacing removes them first.": {
      "comment": "Explanation in the alert shown when importing a JSON dictionary.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обединяването запазва думите, които вече имате, и обновява съвпадащите. Заместването първо ги премахва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučení ponechá slova, která už máte, a aktualizuje ta shodná. Nahrazení je nejdřív odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fletning beholder de ord, du allerede har, og opdaterer dem, der matcher. Erstatning fjerner dem først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zusammenführen bleiben Ihre vorhandenen Wörter erhalten und passende werden aktualisiert. Beim Ersetzen werden sie zuerst entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συγχώνευση κρατά τις λέξεις που έχετε ήδη και ενημερώνει όσες ταιριάζουν. Η αντικατάσταση τις αφαιρεί πρώτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar conserva las palabras que ya tienes y actualiza las que coincidan. Reemplazar las elimina antes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendamine jätab alles olemasolevad sõnad ja uuendab kattuvad. Asendamine eemaldab need esmalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistäminen säilyttää nykyiset sanat ja päivittää vastaavat. Korvaaminen poistaa ne ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion conserve les mots que vous avez déjà et met à jour ceux qui correspondent. Le remplacement les supprime d’abord."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spajanje zadržava riječi koje već imate i ažurira one koje se podudaraju. Zamjena ih prvo uklanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összefésülés megtartja a már meglévő szavakat, és frissíti az egyezőket. A csere előbb törli őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unendo mantieni le parole che hai già e aggiorni quelle corrispondenti. Sostituendo le rimuovi prima."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujungiant išsaugomi jau turimi žodžiai ir atnaujinami sutampantys. Pakeičiant jie pirmiausia pašalinami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apvienojot tiek saglabāti jau esošie vārdi un atjaunināti sakrītošie. Aizstājot tie vispirms tiek noņemti."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-għaqda żżomm il-kelmiet li għandek diġà u taġġorna dawk li jaqblu. Is-sostituzzjoni tneħħihom l-ewwel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen houdt de woorden die je al hebt en werkt de woorden bij die overeenkomen. Vervangen verwijdert ze eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalanie zachowuje dotychczasowe słowa i aktualizuje pasujące. Zastąpienie najpierw je usuwa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntar mantém as palavras que já tem e atualiza as que coincidem. Substituir remove-as primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îmbinarea păstrează cuvintele pe care le ai deja și le actualizează pe cele care se potrivesc. Înlocuirea le elimină mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При объединении ваши слова сохраняются, а совпадающие обновляются. При замене они сначала удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlúčenie ponechá slová, ktoré už máte, a aktualizuje tie, ktoré sa zhodujú. Nahradenie ich najprv odstráni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združevanje ohrani besede, ki jih že imate, in posodobi tiste, ki se ujemajo. Zamenjava jih najprej odstrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanfogning behåller orden du redan har och uppdaterar dem som matchar. Ersättning tar bort dem först."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єднання зберігає наявні слова й оновлює ті, що збігаються. Заміна спершу видаляє їх."
          }
        }
      }
    },
