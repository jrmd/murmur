    "Murmur needs your microphone to hear you while you dictate. It only listens while you hold your dictation shortcut.": {
      "comment": "Lead paragraph on the microphone step.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur се нуждае от микрофона ви, за да ви чува, докато диктувате. Слуша само докато задържате клавишната комбинация за диктовка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur potřebuje mikrofon, aby vás při diktování slyšel. Poslouchá jen tehdy, když držíte zkratku pro diktování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur skal bruge din mikrofon for at høre dig, mens du dikterer. Den lytter kun, mens du holder din dikteringsgenvej nede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur braucht Ihr Mikrofon, um Sie beim Diktieren zu hören. Es hört nur zu, solange Sie Ihren Diktat-Kurzbefehl halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Murmur χρειάζεται το μικρόφωνό σας για να σας ακούει όσο υπαγορεύετε. Ακούει μόνο όσο κρατάτε τη συντόμευση υπαγόρευσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur necesita tu micrófono para oírte mientras dictas. Solo escucha mientras mantienes tu atajo de dictado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur vajab sinu mikrofoni, et sind dikteerimise ajal kuulda. Ta kuulab ainult siis, kui hoiad all oma dikteerimise kiirklahvi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur tarvitsee mikrofonisi kuullakseen sinua sanellessasi. Se kuuntelee vain, kun pidät sanelun pikanäppäintä painettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur a besoin de votre microphone pour vous entendre pendant la dictée. Il n’écoute que lorsque vous maintenez votre raccourci de dictée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur treba vaš mikrofon da bi vas čuo dok diktirate. Sluša samo dok držite prečac za diktiranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Murmurnak szüksége van a mikrofonra, hogy hallja Önt diktálás közben. Csak akkor hallgat, amikor nyomva tartja a diktálás gyorsbillentyűjét."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ha bisogno del microfono per sentirti mentre detti. Ascolta solo mentre tieni premuta la scorciatoia di dettatura."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur reikia mikrofono, kad išgirstų jus diktavimo metu. Jis klausosi tik tada, kai laikote nuspaudę diktavimo spartųjį klavišą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur ir nepieciešams mikrofons, lai dzirdētu jūs diktēšanas laikā. Tas klausās tikai tad, kamēr turat diktēšanas īsceļu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur jeħtieġ il-mikrofon tiegħek biex jismagħek waqt li tiddetta. Jisma’ biss waqt li żżomm is-shortcut tad-dettatura tiegħek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur heeft je microfoon nodig om je te horen tijdens het dicteren. Het luistert alleen terwijl je de dicteersneltoets ingedrukt houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur potrzebuje mikrofonu, aby Cię słyszeć podczas dyktowania. Słucha tylko wtedy, gdy przytrzymujesz skrót do dyktowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Murmur precisa do microfone para o ouvir enquanto dita. Só ouve enquanto mantém o atalho de ditado premido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur are nevoie de microfon pentru a te auzi cât timp dictezi. Ascultă doar cât timp ții apăsată scurtătura de dictare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur нужен микрофон, чтобы слышать вас во время диктовки. Он слушает, только пока вы удерживаете сочетание клавиш для диктовки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur potrebuje mikrofón, aby vás pri diktovaní počul. Počúva len vtedy, keď držíte skratku na diktovanie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur potrebuje vaš mikrofon, da vas sliši med narekovanjem. Posluša le, ko držite bližnjico za narekovanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur behöver mikrofonen för att höra dig när du dikterar. Den lyssnar bara medan du håller dikteringskortkommandot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Murmur потрібен мікрофон, щоб чути вас під час диктування. Він слухає, лише поки ви утримуєте сполучення клавіш для диктування."
          }
        }
      }
    },
