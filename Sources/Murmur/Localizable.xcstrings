    "Fix names and jargon Murmur mishears.\nReplacements run on your Mac before text is pasted.": {
      "comment": "Header of the dictionary tab.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поправете имена и жаргон, които Murmur разбира грешно.\nЗаместванията се извършват на вашия Mac, преди текстът да бъде поставен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte jména a odborné výrazy, kterým Murmur nerozumí.\nNahrazení probíhá na vašem Macu před vložením textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret navne og jargon, som Murmur hører forkert.\nErstatningerne kører på din Mac, før teksten indsættes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigieren Sie Namen und Fachbegriffe, die Murmur falsch versteht.\nErsetzungen laufen auf Ihrem Mac, bevor Text eingefügt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε ονόματα και ορολογία που ο Murmur ακούει λάθος.\nΟι αντικαταστάσεις γίνονται στο Mac σας πριν γίνει επικόλληση του κειμένου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige nombres y jerga que Murmur oiga mal.\nLas sustituciones se hacen en tu Mac antes de pegar el texto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranda nimed ja terminid, mida Murmur valesti kuuleb.\nAsendused tehakse sinu Macis enne teksti kleepimist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa nimet ja erikoissanasto, jotka Murmur kuulee väärin.\nKorvaukset tehdään Macillasi ennen tekstin liittämistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez les noms et le jargon que Murmur entend mal.\nLes remplacements s’exécutent sur votre Mac avant le collage du texte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravite imena i žargon koje Murmur krivo čuje.\nZamjene se izvode na vašem Macu prije lijepljenja teksta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javítsa a Murmur által félrehallott neveket és szakzsargont.\nA cserék a Macen futnak, mielőtt a szöveg beillesztésre kerül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi nomi e termini tecnici che Murmur sente male.\nLe sostituzioni avvengono sul tuo Mac prima che il testo venga incollato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ištaisykite vardus ir žargoną, kuriuos Murmur išgirsta neteisingai.\nPakeitimai atliekami jūsų Mac kompiuteryje prieš įklijuojant tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izlabojiet vārdus un žargonu, ko Murmur pārprot.\nAizstāšana notiek jūsu Mac pirms teksta ielīmēšanas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sewwi ismijiet u ġargon li Murmur jisma’ ħażin.\nIs-sostituzzjonijiet isiru fuq il-Mac tiegħek qabel ma jitwaħħal it-test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer namen en jargon die Murmur verkeerd verstaat.\nVervangingen gebeuren op je Mac voordat de tekst wordt geplakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw nazwy i żargon, które Murmur źle słyszy.\nZamiany działają na Twoim Macu, zanim tekst zostanie wklejony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija nomes e jargão que o Murmur ouve mal.\nAs substituições são feitas no seu Mac antes de o texto ser colado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corectă numele și jargonul pe care Murmur le aude greșit.\nÎnlocuirile rulează pe Mac înainte de lipirea textului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправляйте имена и термины, которые Murmur слышит неверно.\nЗамены выполняются на вашем Mac до вставки текста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte mená a odborné výrazy, ktoré Murmur počuje nesprávne.\nNáhrady sa spúšťajú na vašom Macu pred vložením textu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popravite imena in izraze, ki jih Murmur sliši napačno.\nZamenjave se izvedejo na vašem Macu, preden je besedilo prilepljeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rätta namn och facktermer som Murmur hör fel.\nErsättningarna körs på din Mac innan texten klistras in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправляйте імена й жаргон, які Murmur чує неправильно.\nЗаміни виконуються на вашому Mac до вставлення тексту."
          }
        }
      }
    },
